CUSTOM_API_ADDRESS=http://127.0.0.1:5000

# Optional regional settings used for Gameforge login and blackbox token generation.
IKABOT_LOCALE=en-GB
IKABOT_GF_LANG=en
IKABOT_TIMEZONE_ID=Europe/London

# Optional blackbox token API read timeout in seconds (positive integer; default: 60).
# Empty, invalid, or non-positive values use the default.
# The connection timeout is fixed at 10 seconds. On timeout, interactive login offers manual token entry.
IKABOT_BLACKBOX_TIMEOUT=60

# Optional free construction speedups during the last 5 minutes of a build.
# Disabled by default; set TRUE to enable. Only a verified zero-cost request is sent.
CONSTRUCTION_FREE_SPEEDUP=FALSE

# Maximum random delay before sending a free speedup request, in seconds.
# Positive integer (default: 30); the delay is chosen between 1 and this value.
SPEEDUP_RANDOMWAIT=30

# Optional web server port.
# Empty (default): port derived from the account (43000-44999), as before.
# A number (e.g. 1995): use that port without asking; if it's invalid or in use, the derived port is used.
# ask: prompt for the port each time (replaces the deprecated enable_CustomPort).
IKABOT_WEB_PORT=
