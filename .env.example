CUSTOM_API_ADDRESS=http://127.0.0.1:5000

# Optional regional settings used for Gameforge login and blackbox token generation.
IKABOT_LOCALE=en-GB
IKABOT_GF_LANG=en
IKABOT_TIMEZONE_ID=Europe/London

# Optional blackbox token API read timeout in seconds (positive integer; default: 60).
# Empty, invalid, or non-positive values use the default.
# The connection timeout is fixed at 10 seconds. On timeout, interactive login offers manual token entry.
IKABOT_BLACKBOX_TIMEOUT=60
